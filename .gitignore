# Root .gitignore for Naukarix Monorepo

# Dependencies
node_modules/
*/node_modules/
vendor/
backend/vendor/

# Next.js Build Output
.next/
*/.next/
out/
*/out/
build/
*/build/
.vercel
*/.vercel
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets (Keep .env.example safe)
.env
.env.*
!.env.example
*.local

# Laravel Storage & Cache
backend/storage/pail
backend/storage/*.key
backend/public/storage
backend/public/build
backend/public/hot
backend/.phpunit.cache
backend/.phpunit.result.cache
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/database/*.sqlite
backend/storage/app/public/resumes/*
!backend/storage/app/public/resumes/.gitignore

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
